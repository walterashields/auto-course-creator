    {
      "beat_id": "beat_001",
      "attaches_to": "state",
      "target_id": "state_000",
      "text": "By the end of this video, you'll sort the Orders table so every row lines up from the earliest order date to the latest.",
      "tts_text": null,
      "word_count": 24,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_002",
      "attaches_to": "state",
      "target_id": "state_000",
      "text": "Sorting a column reorders every row by that column's value, so patterns like the very first sale or the most recent one jump right to the top or bottom. That matters here because with a thousand orders, you can't scan for the earliest or latest date by eye.",
      "tts_text": null,
      "word_count": 48,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
