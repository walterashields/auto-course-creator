  "narration_beats": [
    {
      "beat_id": "beat_001",
      "attaches_to": "state",
      "target_id": "state_000",
      "text": "By the end of this video, you'll open the Customers table in DB Browser for SQLite and see its raw rows and columns for the first time.",
      "tts_text": null,
      "word_count": 27,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_002",
      "attaches_to": "state",
      "target_id": "state_000",
      "text": "Opening a table in a database browser shows you the data exactly as it's stored, before any sorting or filtering changes what you see. That matters because if you're about to analyze customer records, you need to trust the raw numbers first.",
      "tts_text": null,
      "word_count": 42,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_003",
      "attaches_to": "edge",
      "target_id": "edge_001",
      "text": "Click the Browse Data tab at the top of the window.",
      "tts_text": null,
      "word_count": 11,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_004",
      "attaches_to": "edge",
      "target_id": "edge_002",
      "text": "Click the table dropdown menu.",
      "tts_text": null,
      "word_count": 5,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_005",
      "attaches_to": "edge",
      "target_id": "edge_003",
      "text": "Select the Customers table from the list.",
      "tts_text": null,
      "word_count": 7,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_006",
      "attaches_to": "edge",
      "target_id": "edge_004",
      "text": "Wait for the data grid to load.",
      "tts_text": null,
      "word_count": 7,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_007",
      "attaches_to": "state",
      "target_id": "state_004",
      "text": "This grid is the Customers table itself, not a copy or a query result. Every row you see here is stored exactly this way in the database file on disk, which means if a number looks wrong here, it's wrong in the source data, not in some later calculation.",
      "tts_text": null,
      "word_count": 49,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_008",
      "attaches_to": "state",
      "target_id": "state_004",
      "text": "The status bar at the bottom of the grid reads 500 rows, and the header row across the top shows 6 columns.",
      "tts_text": null,
      "word_count": 22,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_009",
      "attaches_to": "state",
      "target_id": "state_004",
      "text": "You've now confirmed the Customers table holds 500 rows and 6 columns, straight from the source file, with nothing sorted or filtered yet. Next, you'll sort the Orders table by order_date in ascending order using the column header.",
