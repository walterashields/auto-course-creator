  "narration_beats": [
    {
      "beat_id": "beat_001",
      "attaches_to": "state",
      "target_id": "state_000",
      "text": "By the end of this video, you'll open the Customers table and see it exactly as it's stored on disk, 500 rows and 6 columns, with nothing sorted or filtered yet.",
      "tts_text": null,
      "word_count": 31,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_002",
      "attaches_to": "state",
      "target_id": "state_000",
      "text": "Opening a table in a database browser shows you the raw, unmodified data before any sorting or filtering touches it. That matters because if a customer record ever looks wrong later, you need to know what the original 500 rows actually contained.",
      "tts_text": null,
      "word_count": 42,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_003",
      "attaches_to": "edge",
      "target_id": "edge_001",
      "text": "Click the Browse Data tab at the top of the window.",
      "tts_text": null,
      "word_count": 11,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_004",
      "attaches_to": "edge",
      "target_id": "edge_002",
      "text": "Click the table dropdown menu.",
      "tts_text": null,
      "word_count": 5,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_005",
      "attaches_to": "edge",
      "target_id": "edge_003",
      "text": "Select Customers from the list.",
      "tts_text": null,
      "word_count": 5,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_006",
      "attaches_to": "edge",
      "target_id": "edge_004",
      "text": "Wait for the rows to load.",
      "tts_text": null,
      "word_count": 6,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_007",
      "attaches_to": "state",
      "target_id": "state_004",
      "text": "This grid you're looking at is the Customers table itself, not a copy or a report; it's the same data the database engine reads on every query. Look at the header row: it lists 6 columns, and the status bar at the bottom of the window confirms 500 rows total.",
      "tts_text": null,
      "word_count": 50,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
      "beat_id": "beat_008",
      "attaches_to": "state",
      "target_id": "state_004",
      "text": "You now have the Customers table open and unaltered, 500 rows across 6 columns, ready to serve as your baseline for everything that follows. Next, you'll sort the Orders table by order_date in ascending order using the column header.",
      "tts_text": null,
      "word_count": 39,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    }
  ],
