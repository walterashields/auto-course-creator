    {
      "beat_id": "beat_001",
      "attaches_to": "state",
      "target_id": "state_000",
      "text": "By the end of this video, you'll sort the Orders table by date and instantly spot the earliest and latest order in all 1,000 rows.",
      "tts_text": null,
      "word_count": 25,
      "start_time": 0.0,
