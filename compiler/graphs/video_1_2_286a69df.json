    {
      "beat_id": "beat_008",
      "attaches_to": "state",
      "target_id": "state_003",
      "text": "Sorting order_date in ascending order confirms the earliest order sits at 2021-01-05 and the latest at 2023-11-30, spanning all 1,000 rows. That range tells you exactly how much order history this table covers.",
