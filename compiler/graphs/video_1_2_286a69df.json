      "audio_path": null
    },
    {
      "beat_id": "beat_002",
      "attaches_to": "state",
      "target_id": "state_000",
      "text": "Sorting a column reorders every row by that column's value, so patterns like the very first or most recent activity jump out instead of hiding in random row order. For a business tracking orders, knowing the earliest and latest dates tells you exactly how far back your data goes and how current it is.",
      "tts_text": null,
      "word_count": 54,
      "start_time": 0.0,
      "end_time": 0.0,
      "audio_path": null
    },
    {
